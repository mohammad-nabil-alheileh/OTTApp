{
  "name": "ott-tv-app",
  "version": "1.0.0",
  "private": true,
  "description": "Simple OTT training app: VOD + Live for Android TV + Apple TV (react-native-tvos) and LG webOS (react-native-web)",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "preios": "bash scripts/ensure-pods.sh",
    "ios": "react-native run-tvos --scheme OTTTVApp --simulator \"Apple TV\"",
    "setup:ios": "bash scripts/setup-ios.sh",
    "pods": "cd ios && bundle exec pod install",
    "web": "webpack serve --mode development",
    "web:build": "webpack --mode production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p testing/e2e/web && tsc --noEmit -p testing/e2e/native",
    "lint": "eslint src testing index.ts index.web.ts",
    "test": "jest",
    "test:unit": "jest src testing/unit",
    "test:integration": "jest testing/integration",
    "test:shared": "jest --selectProjects shared",
    "test:android-tv": "jest --selectProjects android-tv",
    "test:apple-tv": "jest --selectProjects apple-tv",
    "test:lg-webos": "jest --selectProjects lg-webos",
    "test:samsung-tizen": "jest --selectProjects samsung-tizen",
    "test:related": "bash testing/run-checks.sh quick",
    "test:e2e:web": "playwright test -c testing/e2e/web",
    "test:e2e:lg-webos": "playwright test -c testing/e2e/web --project lg-webos",
    "test:e2e:samsung-tizen": "playwright test -c testing/e2e/web --project samsung-tizen",
    "test:e2e:android-tv": "E2E_PLATFORM=android-tv wdio run testing/e2e/native/wdio.conf.ts",
    "test:e2e:apple-tv": "E2E_PLATFORM=apple-tv wdio run testing/e2e/native/wdio.conf.ts",
    "verify": "bash testing/run-checks.sh full",
    "verify:e2e": "bash testing/run-checks.sh e2e"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "hls.js": "^1.7.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "npm:react-native-tvos@0.83.10-1",
    "react-native-video": "^6.19.3",
    "react-native-web": "^0.21.4",
    "spatial-navigation-polyfill": "^1.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.25.0",
    "@playwright/test": "^1.65.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@react-native/typescript-config": "0.83.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wdio/appium-service": "^10.1.1",
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "appium": "^3.9.0",
    "appium-uiautomator2-driver": "^8.7.3",
    "babel-loader": "^10.0.0",
    "babel-plugin-react-native-web": "^0.21.0",
    "eslint": "^8.19.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.6.3",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "2.8.8",
    "test-renderer": "^1.3.1",
    "typescript": "^5.8.3",
    "webdriverio": "^10.1.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
