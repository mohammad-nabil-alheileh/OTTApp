{
  "name": "ott-tv-app",
  "version": "1.0.0",
  "private": true,
  "description": "Simple OTT training app: VOD + Live for Android TV + Apple TV (react-native-tvos) and LG webOS (react-native-web)",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-tvos --scheme OTTTVApp --simulator \"Apple TV\"",
    "setup:ios": "bash scripts/setup-ios.sh",
    "pods": "cd ios && bundle exec pod install",
    "web": "webpack serve --mode development",
    "web:build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src index.ts index.web.ts",
    "test": "jest"
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "npm:react-native-tvos@0.83.10-1",
    "react-native-video": "^6.19.3",
    "react-native-web": "^0.21.4",
    "spatial-navigation-polyfill": "^1.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@react-native/typescript-config": "0.83.10",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-react-native-web": "^0.21.0",
    "eslint": "^8.19.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "typescript": "^5.8.3",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
